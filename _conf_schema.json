{
    "ws_host": {
        "description": "WebSocket 监听地址",
        "type": "string",
        "hint": "WebSocket 与文件下载服务监听的网卡地址。",
        "default": "0.0.0.0"
    },
    "ws_port": {
        "description": "WebSocket 端口",
        "type": "int",
        "hint": "与客户端通信的 WebSocket 端口。",
        "default": 8765
    },
    "http_port": {
        "description": "文件下载端口",
        "type": "int",
        "hint": "VRM 模型、背景图、VRMA 动画等大文件的 HTTP 下载端口。",
        "default": 8766
    },
    "director_provider_id": {
        "description": "导演模型 ID",
        "type": "string",
        "hint": "用于在大模型生成原始回复后，在原文中内联插入 [情绪] 标记的模型提供商 ID（表演分段由解析器按标记边界完成，情绪强度为固定默认值）。留空则回退为整段回复保持 neutral 情绪。",
        "default": "",
        "_special": "select_provider"
    },
    "tts_provider_id": {
        "description": "TTS 模型 ID",
        "type": "string",
        "hint": "用于语音合成的 TTS 模型 ID。",
        "default": "",
        "_special": "select_provider_tts"
    },
    "vrm_file": {
        "description": "VRM 模型文件",
        "type": "file",
        "hint": "上传 VRM 模型文件。客户端连接成功后将自动推送该文件用于创建角色。",
        "default": [],
        "file_types": ["vrm"]
    },
    "background_file": {
        "description": "背景图片文件",
        "type": "file",
        "hint": "上传背景图片文件。客户端连接成功后将自动推送该文件用于更新背景。",
        "default": [],
        "file_types": ["png", "jpg", "jpeg", "webp"]
    },
    "vrma_animations": {
        "description": "VRMA 动画",
        "type": "template_list",
        "hint": "每个条目对应一个动画。当前表演流程不再直接触发这些动画，但配置保留以备后续使用；layer=idle 的动画仍可通过 set_idle 工具切换待机姿态。",
        "templates": {
            "animation": {
                "name": "动画",
                "hint": "一个动画名及其对应的 VRMA 文件",
                "display_item": "name",
                "items": {
                    "name": {
                        "description": "动画名",
                        "type": "string",
                        "hint": "动画的唯一标识，必填，支持中文。避免使用 @、[] 等符号。layer=idle 中命名为 idle 的动画会作为前端默认待机动作。",
                        "default": ""
                    },
                    "layer": {
                        "description": "动画用途",
                        "type": "string",
                        "options": ["idle", "gesture", "action"],
                        "hint": "idle=待机动画变体（由 LLM 通过 set_idle 工具切换）、gesture=上半身手势、action=全身动作。当前表演流程不直接触发 gesture/action，仅 idle 生效，其余保留以备后续使用。",
                        "default": "action"
                    },
                    "file": {
                        "description": "VRMA 文件",
                        "type": "file",
                        "hint": "上传一个 VRMA 动画文件。",
                        "default": [],
                        "file_types": ["vrma"]
                    }
                }
            }
        }
    },
    "forced_alignment": {
        "description": "强制对齐服务",
        "type": "object",
        "hint": "将整段 TTS 音频与台词文本做强制对齐（FA），得到每个字/词的时间窗口，用于客户端在整段音频内按分段播放。目前仅支持 https://github.com/0xShug0/audio.cpp 项目的对齐接口。关闭开关或服务不可用时，将降级为按字数估计。",
        "items": {
            "enabled": {
                "description": "启用强制对齐",
                "type": "bool",
                "hint": "关闭时不请求对齐服务，直接按字数估计各分段时间窗口。",
                "default": false
            },
            "api_url": {
                "description": "对齐接口地址",
                "type": "string",
                "hint": "对齐服务接口的完整 URL（含路径），例如 http://127.0.0.1:8080/v1/audio/alignments。",
                "default": ""
            },
            "model": {
                "description": "模型名",
                "type": "string",
                "hint": "请求中的 model 表单字段，需与服务端已加载的对齐模型名一致。",
                "default": "qwen3_forced_aligner"
            },
            "language": {
                "description": "对齐语言",
                "type": "string",
                "options": ["zh", "yue", "en", "de", "es", "fr", "it", "pt", "ru", "ko", "ja"],
                "hint": "台词的语言，需与 TTS 实际播放的语言一致才能得到正确的时间戳。",
                "default": "zh"
            }
        }
    }
}
